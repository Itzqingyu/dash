# ==============================================================================
# DASH 系統環境變數設定範例 (.env.example)
# 請複製此檔案為 .env 並填入實際設定值
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 全域主要 LLM 模型設定 (支援 litellm 格式)
# ------------------------------------------------------------------------------
# 預設使用的語言模型 (例如: openai/gpt-4o, gemini/gemini-1.5-pro, deepseek/deepseek-chat, local/my-model, ollama/llama3)
ACTIVE_MODEL=openai/gpt-4o

# 若使用自定義提供商或通用反向代理，可指定通用 API Base 與 API Key：
# ACTIVE_MODEL_API_BASE=https://api.openai.com/v1
# ACTIVE_MODEL_API_KEY=your_api_key_here

# ------------------------------------------------------------------------------
# 2. 各業務模組專屬 LLM 模型設定 (可選，未設定則自動繼承 ACTIVE_MODEL)
# ------------------------------------------------------------------------------
# 智能對話與 RAG 檢索問答專用模型
# CHAT_MODEL=openai/gpt-4o

# 會議紀錄 1-shot 結構化萃取專用模型
# MEETING_EXTRACTION_MODEL=openai/gpt-4o

# 活動交接清單摘要生成專用模型
# HANDOVER_MODEL=openai/gpt-4o

# Discord Bot 討論串提煉會議專用模型
# DISCORD_BOT_MODEL=openai/gpt-4o

# ------------------------------------------------------------------------------
# 3. LLM 生成溫度參數 (Temperature)
# ------------------------------------------------------------------------------
CHAT_TEMPERATURE=0.7
RAG_TEMPERATURE=0.2
MEETING_EXTRACTION_TEMPERATURE=0.1
HANDOVER_TEMPERATURE=0.3
DISCORD_BOT_TEMPERATURE=0.3

# ------------------------------------------------------------------------------
# 4. 各主流供應商 API 金鑰與 Base URL 設定
# ------------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_API_BASE=https://api.openai.com/v1

# Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_BASE=https://generativelanguage.googleapis.com

# DeepSeek
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_API_BASE=https://api.deepseek.com

# Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_API_BASE=https://api.anthropic.com

# Groq LLM
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_API_BASE=https://api.groq.com/openai/v1

# 本地 llama.cpp 伺服器 (當模型以 local/ 開頭時使用)
LLAMACPP_API_BASE=http://localhost:8080/v1
# LLAMACPP_API_KEY=sk-no-key-required

# 本地 Ollama 伺服器 (當模型以 ollama/ 開頭時使用)
# OLLAMA_API_BASE=http://localhost:11434
# OLLAMA_API_KEY=ollama

# 本地通用推理服務 (LocalAI / vLLM / Text-Generation-WebUI)
# LOCAL_API_BASE=http://localhost:8000/v1
# LOCAL_API_KEY=sk-no-key-required

# ------------------------------------------------------------------------------
# 5. 語音辨識與錄音轉逐字稿設定 (Groq / Whisper)
# ------------------------------------------------------------------------------
# 轉逐字稿使用的模型 (例如: whisper-large-v3, whisper-large-v3-turbo)
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_TRANSCRIPTION_LANGUAGE=zh
GROQ_TRANSCRIPTION_TIMEOUT=120.0
AUDIO_MAX_FILE_SIZE_MB=25

# ------------------------------------------------------------------------------
# 6. 紀錄庫 RAG 向量切塊、Embedding 與 Reranker 模型設定
# ------------------------------------------------------------------------------
# 向量嵌入模型 (FastEmbed 支援模型，如 jinaai/jina-embeddings-v2-base-zh, BAAI/bge-base-zh-v1.5)
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-zh
EMBEDDING_DIMENSION=768

# 重排序模型 (FastEmbed TextCrossEncoder 模型)
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual

# 文件切塊參數
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5

# ------------------------------------------------------------------------------
# 7. 資料庫與資料目錄設定
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://dash_user:dash_password@dash-db:5432/dash_db
# DASH_DATA_DIR=/app/data

# ------------------------------------------------------------------------------
# 8. 安全驗證與權限控制 (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=dash_super_secret_jwt_key_with_at_least_32_characters_safe_for_production_2026

# ------------------------------------------------------------------------------
# 9. Discord 機器人設定
# ------------------------------------------------------------------------------
DISCORD_BOT_TOKEN=your_discord_bot_token_here
